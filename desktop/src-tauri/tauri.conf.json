{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdisChat Desktop",
  "version": "1.2.6",
  "identifier": "com.adischat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "AdisChat",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.ico"],
    "publisher": "AdisChat",
    "copyright": "Copyright (c) 2026 AdisChat",
    "category": "SocialNetworking",
    "shortDescription": "AdisChat Desktop messaging client",
    "longDescription": "A premium desktop messaging client for AdisChat private chats, groups, and channels.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": []
    }
  }
}
